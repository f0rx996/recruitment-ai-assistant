# ---------------------------------------------------------------------------
# Recruitment AI Assistant — environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# ---------------------------------------------------------------------------

# Public site URL (used to build shareable job links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon / publishable key. Safe for the browser; RLS protects all data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service-role / secret key. SERVER ONLY — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (server only)
OPENAI_API_KEY=
# Chat model used by the HR assistant and CV profile extraction
OPENAI_CHAT_MODEL=gpt-5.4-mini
# Embedding model. Must produce 1536-dim vectors (matches the DB column).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Upload limit in megabytes (keep <= 4 on Vercel: request bodies are capped at 4.5 MB)
MAX_CV_SIZE_MB=4

# Applications (and their CV files + AI index) older than this are purged by
# the retention job. Shown to candidates on the privacy page.
DATA_RETENTION_DAYS=180

# Secret used by the scheduled retention endpoint (/api/cron/retention).
# Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Version tag stored with each applicant's consent
CONSENT_VERSION=2026-11-v1

# --- Integration tests only (npm run test:integration) ---------------------
# Set to 1 to run tests against the REAL Supabase project / OpenAI API above.
RUN_INTEGRATION=0
